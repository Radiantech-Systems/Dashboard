# Copy to .env and edit for your environment, then `docker compose up -d --build`

POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry_pw
POSTGRES_DB=telemetry_db

# Allow the frontend origin(s) to call the backend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://192.168.1.20:8080

# IMPORTANT: replace with the Ubuntu server's actual LAN IP so the
# browser (and the built frontend bundle) can reach the backend from
# other machines on the network, not just localhost.
VITE_API_URL=http://192.168.1.20:8000
VITE_WS_URL=ws://192.168.1.20:8000/ws/telemetry

# Shared secret required on every request once this is exposed publicly.
# Generate one with: openssl rand -hex 24
# Leave blank to disable auth for pure local/LAN testing.
API_KEY=
VITE_API_KEY=

# MediaMTX RTSP-to-HLS gateway (the CCTV live-view feature).
# Point this at wherever the mediamtx container is reachable from browsers.
VITE_MEDIAMTX_URL=http://192.168.1.20:8888

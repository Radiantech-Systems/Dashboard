# PostgreSQL connection
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry_pw
POSTGRES_DB=telemetry_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Comma separated list of origins allowed to call the API (frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Number of seconds after which a device with no telemetry is marked offline
DEVICE_OFFLINE_TIMEOUT_SECONDS=5

# Shared secret clients must send as the X-API-Key header (or ?api_key=
# query param for the WebSocket / CSV export links). Blank = auth disabled.
API_KEY=

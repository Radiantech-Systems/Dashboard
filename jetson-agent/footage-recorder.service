# systemd unit to run the footage recorder automatically on Jetson boot,
# as its own independent process alongside telemetry-agent.service.
# Install:
#   sudo cp footage-recorder.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now footage-recorder
[Unit]
Description=Jetson Sliced Footage Recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/telemetry-agent-app
EnvironmentFile=/root/telemetry-agent-app/.env
ExecStart=/root/telemetry-agent-app/venv/bin/python3 /root/telemetry-agent-app/footage_recorder.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

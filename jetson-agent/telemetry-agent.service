# systemd unit to run the agent automatically on Jetson boot.
# All three Jetson services (telemetry-agent, footage-recorder,
# live-stream) live in the SAME folder and share one .env — see
# start-jetson.sh for a one-command way to install/start all three.
# Install:
#   sudo cp telemetry-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now telemetry-agent
[Unit]
Description=Jetson Telemetry Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/telemetry-agent-app
EnvironmentFile=/root/telemetry-agent-app/.env
ExecStart=/root/telemetry-agent-app/venv/bin/python3 /root/telemetry-agent-app/agent.py
# Runs automatically whenever this service stops — including during a
# normal shutdown/reboot — to log a Subsystem Power Details event with
# a real reason, instead of relying only on the server noticing
# telemetry stopped arriving.
ExecStop=/root/telemetry-agent-app/venv/bin/python3 /root/telemetry-agent-app/report_shutdown.py "Service stopped (shutdown, reboot, or manual stop)"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

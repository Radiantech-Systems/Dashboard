# systemd unit to run the live camera stream server automatically on
# Jetson boot, as its own independent process alongside telemetry-agent
# and footage-recorder.
# Install:
#   sudo cp live-stream.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now live-stream
[Unit]
Description=Jetson Live Camera Stream (MJPEG via Flask)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/telemetry-agent-app
EnvironmentFile=/root/telemetry-agent-app/.env
ExecStart=/root/telemetry-agent-app/venv/bin/python3 /root/telemetry-agent-app/live_stream_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

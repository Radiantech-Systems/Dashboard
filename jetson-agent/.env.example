# URL of the backend running on the Ubuntu server (NOT on the Jetson)
SERVER_URL=http://192.168.1.100:8000

# Seconds between telemetry samples
COLLECTION_INTERVAL_SECONDS=1

# Stable identifier for this Jetson (defaults to hostname if unset)
DEVICE_ID=jetson-orin-01
DEVICE_NAME=Jetson AGX Orin #1

# Network interface used for upload/download speed + MAC lookup
NETWORK_INTERFACE=eth0

# Must match the backend's API_KEY exactly once auth is enabled.
API_KEY=

# --- Sliced Footage (recorded video clips) ---
# Runs as a separate process (footage_recorder.py), independent of the
# telemetry agent above.
FOOTAGE_ENABLED=true
# "v4l2" (default) opens FOOTAGE_DEVICE directly — only works if nothing
# else holds that camera. "rtsp" pulls from an existing RTSP stream
# instead (e.g. a webcam already served by another process) so footage
# recording and live view can share one camera without device conflicts.
FOOTAGE_SOURCE_TYPE=v4l2
FOOTAGE_DEVICE=/dev/video0
FOOTAGE_RTSP_URL=
FOOTAGE_SEGMENT_SECONDS=60
FOOTAGE_RESOLUTION=1280x720
FOOTAGE_FRAMERATE=15

# --- Sliced Footage (local slicing on the Jetson, served directly —
# no backend upload). Use this instead of the FOOTAGE_* settings above
# when the camera is remote (e.g. the Ubuntu server's webcam) and you
# want the Jetson itself to slice + serve the clips. ---
FOOTAGE_SLICE_ENABLED=true
FOOTAGE_SLICE_RTSP_URL=rtsp://192.168.1.20:8554/test
FOOTAGE_SLICE_DIR=/root/telemetry-agent-app/footage_clips
FOOTAGE_SLICE_SEGMENT_SECONDS=300
FOOTAGE_RETENTION_HOURS=168
FOOTAGE_SERVER_PORT=5002

# --- Live Camera (MJPEG stream direct from the Jetson, via Flask) ---
# The dashboard's "Live CCTV Streams" link points at this server directly:
#   http://<jetson-ip>:LIVE_STREAM_PORT/video_feed
LIVE_STREAM_DEVICE=/dev/video0
LIVE_STREAM_WIDTH=1280
LIVE_STREAM_HEIGHT=720
LIVE_STREAM_FPS=15
LIVE_STREAM_JPEG_QUALITY=5
LIVE_STREAM_PORT=5001
